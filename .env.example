# Copy to .env (gitignored) and fill in. Ask the database owner for the values.
# Read by tools/academic_db and tools/literature; real environment variables win.

# Academic works database, used by tools/academic_db (academic-db-mcp).
ACADEMIC_DB_URL=postgresql://external_full:CHANGE_ME@<db-host>:5432/academic?sslmode=require
ACADEMIC_DB_READER_URL=postgresql://academic_reader:CHANGE_ME@<db-host>:5432/academic?sslmode=require

# Literature tools: any real email address. Required by Unpaywall (the Verifier's
# PDF fallback) and used for Crossref's polite pool.
CONTACT_EMAIL=

# Optional
# S2_API_KEY=            # Semantic Scholar API key: strongly recommended. Without it, citation sentences
#                        # and full-text passage search are mostly unavailable (rate limits)
# OPENALEX_MAILTO=       # your email, for OpenAlex's polite pool
# OPENALEX_API_KEY=      # free key from openalex.org, for the literature tools' OpenAlex searches

# The model login is not set here: run `omnigent setup` (Pi login or an OpenRouter key).
