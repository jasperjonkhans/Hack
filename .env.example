# Copy to .env and fill in. .env is gitignored: never commit it.
# Read by academic_db and the literature tools; real environment variables win.

# Shared academic database (ask Federico). Required for saving papers, claims and verdicts.
ACADEMIC_DB_URL=
ACADEMIC_DB_READER_URL=

# Any real email address. Required by Unpaywall; also used for Crossref's polite pool.
CONTACT_EMAIL=

# Optional. Free key from openalex.org; without it OpenAlex is rate-limited sooner.
OPENALEX_API_KEY=
# Optional. Email for academic_db's OpenAlex requests (faster pool).
OPENALEX_MAILTO=

# Optional. Semantic Scholar key for the Verifier's counter-evidence tools.
S2_API_KEY=

# The model login is not set here: run `omnigent setup` (Pi login or an OpenRouter key).
