[Unit]
Description=Omnigent agent host for the team server
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/hack/demo/workspace
EnvironmentFile=/etc/hack/host.env
# Claude Code's native installer puts `claude` in ~/.local/bin.
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/hack/.venv/bin/omnigent host ${OMNIGENT_URL}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
